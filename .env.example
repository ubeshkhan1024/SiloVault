# =============================================================================
# SiloVault Environment Variables Template
#
# Copy this file to `.env` and fill in local values.
# NEVER commit the real `.env` file to Git.
# =============================================================================

# Server binding (loopback default for local privacy)
HOST=127.0.0.1
PORT=8000
DEBUG=false

# SQLite database file path (relative to workspace root)
DATABASE_PATH=silo_vault.db

# API Prefix
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Cloud & AI Integration Placeholders (Not yet functional)
#
# The variables below are documented for planned future integrations.
# They are NOT currently read by the application: backend/config.py
# defines no matching settings fields, and pydantic-settings is
# configured with extra="ignore", so these values have no effect
# until the corresponding integrations are implemented.
# -----------------------------------------------------------------------------

# --- Planned: read by the application once the fields exist in config.py ---

# Google Drive API credentials (to be created in Google Cloud Console)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Supabase credentials (if selected for cloud control plane)
SUPABASE_URL=
SUPABASE_KEY=

# --- Planned: not currently read by the application ---

# Google Drive Mobile Inbox folder ID (future integration)
GOOGLE_DRIVE_MOBILE_INBOX_ID=

# Local Ollama AI service binding (future integration)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b