# =============================================================================
# SiloVault Environment Variables Template
#
# Copy this file to `.env` and fill in local values.
# NEVER commit the real `.env` file to Git.
# =============================================================================

# Server binding (loopback default for local privacy)
HOST=127.0.0.1
PORT=8000
DEBUG=false

# SQLite database file path (relative to workspace root)
# This is the single source of truth for both the FastAPI app and Alembic.
# Override via environment variable for testing / autogenerate:
#   DATABASE_PATH=silo_vault_test.db alembic revision --autogenerate -m "..."
DATABASE_PATH=silo_vault.db

# API Prefix
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Google Drive OAuth Configuration (M3.1)
#
# Create credentials in Google Cloud Console:
#   APIs & Services > Credentials > Create Credentials > OAuth client ID
#   Application type: Desktop app
#   Authorized redirect URIs: http://localhost:<port>/ (any port; we use random)
#
# Scope: https://www.googleapis.com/auth/drive.file (per-file access only)
# -----------------------------------------------------------------------------

# Google Drive OAuth client credentials (required for Google Drive integration)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# OAuth redirect URI for the installed-app loopback flow.
# Uses a random available port on localhost; the port is chosen at runtime.
# Override only if you need a fixed port for firewall/proxy reasons.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:0

# OAuth scopes (space-separated). Default is drive.file for per-file access.
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file

# -----------------------------------------------------------------------------
# Cloud & AI Integration Placeholders (Not yet functional)
#
# The variables below are documented for planned future integrations.
# They are NOT currently read by the application: backend/config.py
# defines no matching settings fields, and pydantic-settings is
# configured with extra="ignore", so these values have no effect
# until the corresponding integrations are implemented.
# -----------------------------------------------------------------------------

# Supabase credentials (if selected for cloud control plane)
SUPABASE_URL=
SUPABASE_KEY=

# --- Planned: not currently read by the application ---

# Google Drive Mobile Inbox folder ID (future integration)
GOOGLE_DRIVE_MOBILE_INBOX_ID=

# Local Ollama AI service binding (future integration)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b